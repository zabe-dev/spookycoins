# Required once Better Auth is enabled.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: enables Google login when configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required in production for signup verification and password reset codes.
# The default Resend sandbox sender only works for verified recipient testing.
RESEND_API_KEY=
AUTH_EMAIL_FROM="SpookyCoins <onboarding@resend.dev>"

# Required once persistent application data is enabled.
DATABASE_URL=

# Required for submitted project logos and future static project assets.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# Optional: use when public asset URLs should come from a CDN or custom domain.
S3_PUBLIC_URL=

# Optional: topbar market/platform data refresh and API safety limits.
TOPBAR_SUMMARY_CACHE_SECONDS=60
TOPBAR_PRICE_CACHE_SECONDS=60
TOPBAR_PRICE_DAILY_LIMIT=480
