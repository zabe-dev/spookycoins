# Required once Better Auth is enabled.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: enables Google login when configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required in production for signup verification and password reset codes.
# The default Resend sandbox sender only works for verified recipient testing.
RESEND_API_KEY=
AUTH_EMAIL_FROM="SpookyCoins <onboarding@resend.dev>"

# Required once persistent application data is enabled.
DATABASE_URL=
